# ---- Copy to .env for local dev. Production values go in the Render dashboard (see README). ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000          # public URL of the front end (email links)
API_URL=http://localhost:3000          # public URL of the API (webhook target, signed file URLs)
CORS_ORIGIN=http://localhost:3000      # comma-separated allowed origins; never * in production
# COOKIE_SAMESITE=lax                  # lax (same-site / Vercel rewrite) | none (cross-site API) | strict

# Database — local: `npm run db:local` starts embedded Postgres on 5433
DATABASE_URL=postgresql://sharik:sharik@localhost:5433/sharik
DIRECT_URL=postgresql://sharik:sharik@localhost:5433/sharik
# TEST_DATABASE_URL=postgresql://sharik:sharik@localhost:5433/sharik_test

# Secrets — dev defaults exist; REQUIRED in production. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=
WEBHOOK_SECRET=
FILE_URL_SECRET=
FIELD_ENCRYPTION_KEY=                  # openssl rand -base64 32  (exactly 32 bytes)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

PLATFORM_FEE_BPS=250                   # 2.5% fee on funded campaigns
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=300
JOBS_MODE=worker                       # worker | inline (tests/seed) | off
JOB_POLL_MS=1000

# Optional integrations (blank = local fallback)
REDIS_URL=                             # BullMQ jobs + Redis listing cache (else Postgres queue + memory cache)
RESEND_API_KEY=                        # real email (else logged + stored in Notification table / dev outbox)
MAIL_FROM=Shareek <onboarding@resend.dev>
SUPABASE_URL=                          # Supabase Storage for uploads (else ./uploads with HMAC-signed URLs)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sharik-docs
UPLOAD_DIR=./uploads
SENTRY_DSN=
LOG_LEVEL=debug
# ENABLE_DEV_OUTBOX=true               # expose /api/v1/dev/outbox in production (staging only!)
